// Small widgets styled for the black notch (std-widgets follow the OS style, which clashes).

// Apple dark palette. fg/surface are set from Rust (light variant for theme = "system").
export global Palette {
    in property <color> accent: #0A84FF;
    in property <color> fg: white;
    in property <color> fg-dim: #ebebf599;
    in property <color> fg-faint: #ebebf54d;
    in property <color> surface: #1c1c1e;
    in property <color> surface-hover: #2c2c2e;
    in property <color> separator: #ffffff1a;
    out property <color> green: #30d158;
    out property <color> orange: #ff9f0a;
    out property <color> red: #ff453a;
    out property <color> purple: #bf5af2;
    out property <color> teal: #64d2ff;
    out property <color> yellow: #ffd60a;
}

// Monochrome line icon by id (assets/icons/<id>.svg), tinted with `tint`.
export component Icon inherits Image {
    in property <string> name;
    in property <color> tint: Palette.fg;
    colorize: root.tint;
    image-fit: contain;
    source: root.name == "home" ? @image-url("../assets/icons/home.svg")
        : root.name == "timer" ? @image-url("../assets/icons/timer.svg")
        : root.name == "calc" ? @image-url("../assets/icons/calc.svg")
        : root.name == "stats" ? @image-url("../assets/icons/stats.svg")
        : root.name == "clipboard" ? @image-url("../assets/icons/clipboard.svg")
        : root.name == "shelf" ? @image-url("../assets/icons/shelf.svg")
        : root.name == "terminal" ? @image-url("../assets/icons/terminal.svg")
        : root.name == "calendar" ? @image-url("../assets/icons/calendar.svg")
        : root.name == "ai" ? @image-url("../assets/icons/ai.svg")
        : root.name == "muted" ? @image-url("../assets/icons/muted.svg")
        : root.name == "volume" ? @image-url("../assets/icons/volume.svg")
        : root.name == "bolt" ? @image-url("../assets/icons/bolt.svg")
        : root.name == "battery" ? @image-url("../assets/icons/battery.svg")
        : root.name == "battery-low" ? @image-url("../assets/icons/battery-low.svg")
        : root.name == "awake" ? @image-url("../assets/icons/awake.svg")
        : root.name == "mirror" ? @image-url("../assets/icons/mirror.svg")
        : root.name == "devices" ? @image-url("../assets/icons/devices.svg")
        : root.name == "headphones" ? @image-url("../assets/icons/headphones.svg")
        : root.name == "keyboard" ? @image-url("../assets/icons/keyboard.svg")
        : root.name == "mouse" ? @image-url("../assets/icons/mouse.svg")
        : root.name == "download" ? @image-url("../assets/icons/download.svg")
        : root.name == "downloads" ? @image-url("../assets/icons/download.svg")
        : root.name == "caps" ? @image-url("../assets/icons/caps.svg")
        : root.name == "mic" ? @image-url("../assets/icons/mic.svg")
        : root.name == "camera" ? @image-url("../assets/icons/camera.svg")
        : root.name == "wifi" ? @image-url("../assets/icons/wifi.svg")
        : root.name == "wifi-off" ? @image-url("../assets/icons/wifi-off.svg")
        : root.name == "moon" ? @image-url("../assets/icons/moon.svg")
        : root.name == "music" ? @image-url("../assets/icons/music.svg")
        : root.name == "previous" ? @image-url("../assets/icons/previous.svg")
        : root.name == "next" ? @image-url("../assets/icons/next.svg")
        : root.name == "play" ? @image-url("../assets/icons/play.svg")
        : root.name == "pause" ? @image-url("../assets/icons/pause.svg")
        : root.name == "reset" ? @image-url("../assets/icons/reset.svg")
        : root.name == "file" ? @image-url("../assets/icons/file.svg")
        : root.name == "folder" ? @image-url("../assets/icons/folder.svg")
        : root.name == "close" ? @image-url("../assets/icons/close.svg")
        : root.name == "open" ? @image-url("../assets/icons/open.svg")
        : root.name == "trash" ? @image-url("../assets/icons/trash.svg")
        : root.name == "cpu" ? @image-url("../assets/icons/cpu.svg")
        : root.name == "memory" ? @image-url("../assets/icons/memory.svg")
        : root.name == "network" ? @image-url("../assets/icons/network.svg")
        : root.name == "disk" ? @image-url("../assets/icons/disk.svg")
        : @image-url("../assets/icons/settings.svg");
}

// Card used across module views.
export component Card inherits Rectangle {
    background: Palette.surface;
    border-radius: 14px;
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <length> font-size: 13px;
    callback clicked();

    min-height: 28px;
    min-width: 36px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.active ? Palette.accent : (touch.has-hover ? Palette.surface-hover : Palette.surface);
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: Palette.fg;
            font-size: root.font-size;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Round icon button (bars of actions under shelf, downloads, timer).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> size: 32px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.pressed ? Palette.surface-hover.brighter(0.2) : touch.has-hover ? Palette.surface-hover : Palette.surface;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { width: root.size * 0.45; height: root.size * 0.45; name: root.icon; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Circular progress from 12 o'clock, clockwise.
export component Ring inherits Rectangle {
    in property <float> progress;
    in property <color> tint: Palette.orange;
    in property <length> thickness: 5px;
    property <float> size: self.width / 1px;
    property <float> r: (self.size - self.thickness / 1px) / 2;
    property <float> c: self.size / 2;
    property <float> a: clamp(root.progress, 0.0005, 0.9995) * 360;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.size;
        viewbox-height: root.size;
        stroke: Palette.surface-hover;
        stroke-width: root.thickness;
        commands: "M " + root.c + " " + (root.c - root.r) + " A " + root.r + " " + root.r + " 0 1 1 " + (root.c - 0.01) + " " + (root.c - root.r);
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.size;
        viewbox-height: root.size;
        stroke: root.tint;
        stroke-width: root.thickness;
        commands: "M " + root.c + " " + (root.c - root.r) + " A " + root.r + " " + root.r + " 0 "
            + (root.a > 180 ? "1" : "0") + " 1 "
            + (root.c + root.r * sin(root.a * 1deg)) + " " + (root.c - root.r * cos(root.a * 1deg));
    }
    @children
}

