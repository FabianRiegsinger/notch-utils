import { Palette, Icon } from "../components.slint";

export struct LabeledValue {
    label: string,
    text: string,
    // 0..1 for a bar; negative = no bar.
    frac: float,
}

export global StatsState {
    in property <bool> detailed;
    in property <string> cpu-text: "–";
    in property <string> mem-text: "–";
    in property <string> down-text: "–";
    in property <string> up-text: "–";
    // Last 60 samples, each scaled to 0..1, oldest first.
    in property <[float]> cpu-hist;
    in property <[float]> mem-hist;
    in property <[float]> down-hist;
    in property <[float]> up-hist;
    in property <[float]> cores;
    in property <[LabeledValue]> disks;
    in property <[LabeledValue]> temps;
    in property <[LabeledValue]> procs;
    in property <string> battery-text;
    // Compact cards: area charts (60 x 100 viewbox paths), memory and system volume.
    in property <string> cpu-path;
    in property <string> mem-path;
    in property <string> net-path;
    in property <string> mem-used: "–";
    in property <string> mem-sub;
    in property <string> disk-free: "–";
    in property <string> disk-sub;
    in property <float> disk-frac;
}

// Bar chart of the last 60 samples, right-aligned so the newest is at the right edge.
component Spark inherits Rectangle {
    in property <[float]> values;
    in property <color> bar-color: Palette.accent;
    property <length> step: self.width / 60;
    for v[i] in root.values: Rectangle {
        x: (60 - root.values.length + i) * root.step;
        width: max(root.step - 1px, 1px);
        height: max(root.height * clamp(v, 0, 1), 1px);
        y: root.height - self.height;
        background: root.bar-color;
    }
}

component Card inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    // Area chart along the bottom edge (see area_path in stats.rs); empty = none.
    in property <string> chart;
    background: Palette.surface;
    border-radius: 14px;
    horizontal-stretch: 1;
    preferred-width: 100px;
    clip: true;

    if root.chart != "": Path {
        x: 0;
        y: parent.height - self.height + 1px;
        width: parent.width;
        height: parent.height * 0.36;
        viewbox-width: 60;
        viewbox-height: 100;
        fill: Palette.fg.with-alpha(0.22);
        stroke: Palette.fg.with-alpha(0.75);
        stroke-width: 1.5px;
        commands: root.chart;
    }
    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        alignment: start;
        HorizontalLayout {
            spacing: 5px;
            Icon { width: 12px; height: 12px; y: (parent.height - 12px) / 2; name: root.icon; tint: Palette.fg-dim; }
            Text { text: root.title; color: Palette.fg-dim; font-size: 11px; font-weight: 500; }
        }
        Text { text: root.value; color: Palette.fg; font-size: 21px; font-weight: 600; }
        if root.sub != "": Text { text: root.sub; color: Palette.fg-dim; font-size: 11px; overflow: elide; }
    }
    @children
}

component Bar inherits Rectangle {
    in property <float> frac;
    height: 6px;
    border-radius: 3px;
    background: Palette.surface;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.frac, 0, 1);
        border-radius: 3px;
        background: root.frac > 0.85 ? #ff453a : Palette.accent;
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;
    Text { text: root.title; color: Palette.fg-dim; font-size: 11px; }
    @children
}

component Rows inherits VerticalLayout {
    in property <[LabeledValue]> rows;
    spacing: 3px;
    for r in root.rows: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            Text { text: r.label; color: Palette.fg; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
            Text { text: r.text; color: Palette.fg-dim; font-size: 11px; }
        }
        if r.frac >= 0: Bar { frac: r.frac; }
    }
}

export component StatsView inherits VerticalLayout {
    if !StatsState.detailed: HorizontalLayout {
        spacing: 8px;
        Card { icon: "cpu"; title: "CPU"; value: StatsState.cpu-text; chart: StatsState.cpu-path; }
        Card { icon: "memory"; title: "Memory"; value: StatsState.mem-used; sub: StatsState.mem-sub; chart: StatsState.mem-path; }
        Card { icon: "network"; title: "Network"; value: StatsState.down-text; sub: "↓ " + StatsState.down-text + " · ↑ " + StatsState.up-text; chart: StatsState.net-path; }
        Card {
            icon: "disk";
            title: "Disk";
            value: StatsState.disk-free;
            sub: StatsState.disk-sub;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                alignment: end;
                Text { text: Math.round(StatsState.disk-frac * 100) + "% used"; color: Palette.fg-dim; font-size: 11px; }
                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: Palette.surface-hover;
                    Rectangle { x: 0; width: parent.width * clamp(StatsState.disk-frac, 0, 1); border-radius: 2.5px; background: Palette.fg; }
                }
            }
        }
    }

    if StatsState.detailed: Flickable {
        content-height: detail.preferred-height;
        detail := HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                Section {
                    title: "CPU " + StatsState.cpu-text + "   ·   Memory " + StatsState.mem-text;
                    HorizontalLayout {
                        spacing: 2px;
                        height: 36px;
                        for c in StatsState.cores: Rectangle {
                            background: Palette.surface;
                            border-radius: 2px;
                            Rectangle {
                                y: parent.height * (1 - clamp(c, 0, 1));
                                height: parent.height * clamp(c, 0, 1);
                                border-radius: 2px;
                                background: Palette.accent;
                            }
                        }
                    }
                }
                Section {
                    title: "Network   ↓ " + StatsState.down-text + "   ↑ " + StatsState.up-text;
                }
                Section {
                    title: "Disks";
                    Rows { rows: StatsState.disks; }
                }
                if StatsState.battery-text != "": Section {
                    title: "Battery";
                    Text { text: StatsState.battery-text; color: Palette.fg; font-size: 11px; }
                }
            }
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                Section {
                    title: "Top processes";
                    Rows { rows: StatsState.procs; }
                }
                if StatsState.temps.length > 0: Section {
                    title: "Temperatures";
                    Rows { rows: StatsState.temps; }
                }
            }
        }
    }
}
