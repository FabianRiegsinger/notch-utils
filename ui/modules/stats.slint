import { Palette, Icon } from "../components.slint";

export struct LabeledValue {
    label: string,
    text: string,
    // 0..1 for a bar; negative = no bar.
    frac: float,
}

export global StatsState {
    in property <bool> detailed;
    in property <string> cpu-text: "–";
    in property <string> mem-text: "–";
    in property <string> down-text: "–";
    in property <string> up-text: "–";
    // Last 60 samples, each scaled to 0..1, oldest first.
    in property <[float]> cpu-hist;
    in property <[float]> mem-hist;
    in property <[float]> down-hist;
    in property <[float]> up-hist;
    in property <[float]> cores;
    in property <[LabeledValue]> disks;
    in property <[LabeledValue]> temps;
    in property <[LabeledValue]> procs;
    in property <string> battery-text;
    // Compact cards: memory and system volume.
    in property <string> mem-used: "–";
    in property <string> mem-sub;
    in property <string> disk-free: "–";
    in property <string> disk-sub;
    in property <float> disk-frac;
    // Compact cards: big number + small unit.
    in property <string> cpu-num: "–";
    in property <string> cpu-sub;
    in property <[float]> cpu-bars;
    in property <string> mem-num: "–";
    in property <string> mem-unit;
    in property <string> down-num: "–";
    in property <string> down-unit;
    in property <string> disk-num: "–";
    in property <string> disk-unit;
    in property <bool> has-gpu;
    in property <string> gpu-num: "–";
    in property <string> gpu-sub;
    in property <[float]> gpu-hist;
}

// Area chart from abutting columns, each with a bright top edge, filling from the right over
// 60 slots (one per second). A Path keeps its viewbox's aspect ratio, so it can't stretch.
component Chart inherits Rectangle {
    in property <[float]> values;
    HorizontalLayout {
        Rectangle { horizontal-stretch: max(0, 60 - root.values.length); }
        for v in root.values: Rectangle {
            horizontal-stretch: 1;
            property <length> top: self.height * (1 - 0.92 * clamp(v, 0, 1));
            Rectangle { y: parent.top; height: parent.height - parent.top; background: Palette.fg.with-alpha(0.22); }
            Rectangle { y: parent.top; height: 2px; background: Palette.fg.with-alpha(0.85); }
        }
    }
}

component Card inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> value;
    in property <string> unit;
    in property <string> sub;
    // Small bars beside the value (CPU cores), 0..1 each.
    in property <[float]> bars;
    // Area chart along the bottom edge, 0..1 per sample, oldest first; fewer than 2 = none.
    in property <[float]> chart;
    background: Palette.surface;
    border-radius: 14px;
    horizontal-stretch: 1;
    preferred-width: 100px;
    clip: true;

    if root.chart.length > 1: Chart {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: parent.height * 0.4;
        values: root.chart;
    }
    VerticalLayout {
        padding: 14px;
        spacing: 2px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            Icon { width: 14px; height: 14px; y: (parent.height - 14px) / 2; name: root.icon; tint: Palette.fg-dim; }
            Text { text: root.title; color: Palette.fg-dim; font-size: 13px; font-weight: 500; }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 3px;
            Text { text: root.value; color: Palette.fg; font-size: 26px; font-weight: 700; vertical-alignment: bottom; }
            Text { text: root.unit; color: Palette.fg-dim; font-size: 14px; font-weight: 600; vertical-alignment: bottom; }
            if root.bars.length > 0: HorizontalLayout {
                padding-left: 8px;
                padding-bottom: 6px;
                spacing: 2px;
                alignment: start;
                for b in root.bars: Rectangle {
                    width: 3px;
                    Rectangle {
                        y: parent.height - self.height;
                        height: max(3px, parent.height * 0.75 * clamp(b, 0, 1));
                        border-radius: 1.5px;
                        background: Palette.fg;
                    }
                }
            }
        }
        if root.sub != "": Text { text: root.sub; color: Palette.fg-dim; font-size: 12px; overflow: elide; }
    }
    @children
}

component Bar inherits Rectangle {
    in property <float> frac;
    height: 6px;
    border-radius: 3px;
    background: Palette.surface;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.frac, 0, 1);
        border-radius: 3px;
        background: root.frac > 0.85 ? #ff453a : Palette.accent;
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;
    Text { text: root.title; color: Palette.fg-dim; font-size: 11px; }
    @children
}

component Rows inherits VerticalLayout {
    in property <[LabeledValue]> rows;
    spacing: 3px;
    for r in root.rows: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            Text { text: r.label; color: Palette.fg; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
            Text { text: r.text; color: Palette.fg-dim; font-size: 11px; }
        }
        if r.frac >= 0: Bar { frac: r.frac; }
    }
}

export component StatsView inherits VerticalLayout {
    if !StatsState.detailed: HorizontalLayout {
        spacing: 8px;
        Card { icon: "cpu"; title: "CPU"; value: StatsState.cpu-num; unit: "%"; sub: StatsState.cpu-sub; bars: StatsState.cpu-bars; chart: StatsState.cpu-hist; }
        Card { icon: "memory"; title: "Memory"; value: StatsState.mem-num; unit: StatsState.mem-unit; sub: StatsState.mem-sub; chart: StatsState.mem-hist; }
        Card { icon: "network"; title: "Network"; value: StatsState.down-num; unit: StatsState.down-unit; sub: "↓ " + StatsState.down-text + " · ↑ " + StatsState.up-text; chart: StatsState.down-hist; }
        if StatsState.has-gpu: Card { icon: "gpu"; title: "GPU"; value: StatsState.gpu-num; unit: "%"; sub: StatsState.gpu-sub; chart: StatsState.gpu-hist; }
        Card {
            icon: "disk";
            title: "Disk";
            value: StatsState.disk-num;
            unit: StatsState.disk-unit;
            sub: StatsState.disk-sub;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: end;
                Text { text: Math.round(StatsState.disk-frac * 100) + "% used"; color: Palette.fg-dim; font-size: 12px; }
                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: Palette.surface-hover;
                    Rectangle { x: 0; width: parent.width * clamp(StatsState.disk-frac, 0, 1); border-radius: 2.5px; background: Palette.fg; }
                }
            }
        }
    }

    if StatsState.detailed: Flickable {
        content-height: detail.preferred-height;
        detail := HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                Section {
                    title: "CPU " + StatsState.cpu-text + "   ·   Memory " + StatsState.mem-text;
                    HorizontalLayout {
                        spacing: 2px;
                        height: 36px;
                        for c in StatsState.cores: Rectangle {
                            background: Palette.surface;
                            border-radius: 2px;
                            Rectangle {
                                y: parent.height * (1 - clamp(c, 0, 1));
                                height: parent.height * clamp(c, 0, 1);
                                border-radius: 2px;
                                background: Palette.accent;
                            }
                        }
                    }
                }
                Section {
                    title: "Network   ↓ " + StatsState.down-text + "   ↑ " + StatsState.up-text;
                }
                Section {
                    title: "Disks";
                    Rows { rows: StatsState.disks; }
                }
                if StatsState.battery-text != "": Section {
                    title: "Battery";
                    Text { text: StatsState.battery-text; color: Palette.fg; font-size: 11px; }
                }
            }
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                Section {
                    title: "Top processes";
                    Rows { rows: StatsState.procs; }
                }
                if StatsState.temps.length > 0: Section {
                    title: "Temperatures";
                    Rows { rows: StatsState.temps; }
                }
            }
        }
    }
}
