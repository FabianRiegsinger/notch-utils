import { Palette, Icon } from "../components.slint";

export global AwakeState {
    in property <bool> on;
    in property <string> status: "Off";
    // Selected minutes: -1 off, 0 until turned off.
    in property <int> mode: -1;
    // Keep the display on too (else the computer only).
    in property <bool> display: true;
    // "Mac" or "Computer".
    in property <string> device: "Mac";
    // minutes: 0 = until turned off, negative = off
    callback set(int);
    callback set-display(bool);
}

// Rounded choice button: yellow when selected.
component Choice inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    height: 38px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: root.active ? Palette.yellow : touch.has-hover ? Palette.surface-hover : Palette.surface;
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : "Until turned off";
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon != "": Icon {
            width: 17px;
            height: 17px;
            y: (parent.height - 17px) / 2;
            name: root.icon;
            tint: root.active ? #000 : Palette.fg;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.active ? #000 : Palette.fg;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Minutes inherits Choice {
    in property <int> minutes;
    active: AwakeState.mode == root.minutes;
    clicked => { AwakeState.set(root.minutes); }
}

export component AwakeView inherits HorizontalLayout {
    spacing: 22px;
    padding-left: 8px;

    HorizontalLayout {
        spacing: 16px;
        width: 260px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: AwakeState.on ? Palette.yellow.with-alpha(0.2) : Palette.surface;
                animate background { duration: 250ms; }
                Icon { width: 28px; height: 28px; name: "awake"; tint: AwakeState.on ? Palette.yellow : Palette.fg-dim; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: AwakeState.on ? "Staying awake" : "Keep Awake"; color: Palette.fg; font-size: 17px; font-weight: 600; }
            Text { text: AwakeState.status; color: AwakeState.on ? Palette.yellow : Palette.fg-dim; font-size: 15px; font-weight: 600; }
            Text {
                text: AwakeState.display ? AwakeState.device + " and display" : AwakeState.device + " only";
                color: Palette.fg-dim;
                font-size: 13px;
            }
            HorizontalLayout {
                padding-top: 8px;
                alignment: start;
                Rectangle {
                    height: 32px;
                    width: toggle.preferred-width + 26px;
                    border-radius: 16px;
                    background: t-touch.has-hover ? Palette.surface-hover : Palette.surface;
                    accessible-role: button;
                    accessible-label: AwakeState.on ? "Turn Off" : "Turn On";
                    accessible-action-default => { AwakeState.set(AwakeState.on ? -1 : max(AwakeState.mode, 0)); }
                    toggle := HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Icon {
                            width: 11px;
                            height: 11px;
                            y: (parent.height - 11px) / 2;
                            name: AwakeState.on ? "stop" : "awake";
                        }
                        Text { text: AwakeState.on ? "Turn Off" : "Turn On"; color: Palette.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    }
                    t-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AwakeState.set(AwakeState.on ? -1 : max(AwakeState.mode, 0)); }
                    }
                }
            }
        }
    }

    Rectangle { width: 1px; background: Palette.separator; }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 8px;
        Text { text: "For"; color: Palette.fg-dim; font-size: 12px; font-weight: 600; }
        HorizontalLayout {
            spacing: 6px;
            Minutes { text: "15m"; minutes: 15; }
            Minutes { text: "30m"; minutes: 30; }
            Minutes { text: "1h"; minutes: 60; }
            Minutes { text: "2h"; minutes: 120; }
            Minutes { text: "5h"; minutes: 300; }
            Minutes { icon: "infinity"; minutes: 0; }
        }
        Rectangle { height: 4px; }
        Text { text: "Stays awake"; color: Palette.fg-dim; font-size: 12px; font-weight: 600; }
        HorizontalLayout {
            spacing: 6px;
            Choice {
                icon: "display";
                text: AwakeState.device + " and display";
                active: AwakeState.display;
                clicked => { AwakeState.set-display(true); }
            }
            Choice {
                icon: "laptop";
                text: AwakeState.device + " only";
                active: !AwakeState.display;
                clicked => { AwakeState.set-display(false); }
            }
        }
    }
}
