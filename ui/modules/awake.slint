import { Palette, Icon, Pill } from "../components.slint";

export global AwakeState {
    in property <bool> on;
    in property <string> status: "Off";
    // Selected minutes: -1 off, 0 until turned off.
    in property <int> mode: -1;
    // minutes: 0 = until turned off, negative = off
    callback set(int);
}

component Choice inherits Rectangle {
    in property <string> text;
    in property <int> minutes;
    height: 34px;
    horizontal-stretch: 1;
    border-radius: 10px;
    property <bool> active: AwakeState.mode == root.minutes;
    background: root.active ? Palette.yellow : touch.has-hover ? Palette.surface-hover : Palette.surface;
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { AwakeState.set(root.minutes); }
    Text { text: root.text; color: root.active ? #000 : Palette.fg; font-size: 13px; font-weight: 600; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { AwakeState.set(root.minutes); } }
}

export component AwakeView inherits HorizontalLayout {
    spacing: 22px;
    padding-left: 8px;

    HorizontalLayout {
        spacing: 14px;
        width: 250px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: AwakeState.on ? Palette.yellow.with-alpha(0.2) : Palette.surface;
                animate background { duration: 250ms; }
                Icon { width: 26px; height: 26px; name: "awake"; tint: AwakeState.on ? Palette.yellow : Palette.fg-dim; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: AwakeState.on ? "Staying awake" : "Keep Awake"; color: Palette.fg; font-size: 16px; font-weight: 600; }
            Text { text: AwakeState.status; color: AwakeState.on ? Palette.yellow : Palette.fg-dim; font-size: 14px; font-weight: 600; }
            Text { text: "Mac and display"; color: Palette.fg-dim; font-size: 12px; }
            HorizontalLayout {
                padding-top: 6px;
                alignment: start;
                Pill {
                    text: AwakeState.on ? "■  Turn Off" : "Turn On";
                    font-size: 12px;
                    clicked => { AwakeState.set(AwakeState.on ? -1 : AwakeState.mode < 0 ? 0 : AwakeState.mode); }
                }
            }
        }
    }

    Rectangle { width: 1px; background: Palette.separator; }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 8px;
        Text { text: "For"; color: Palette.fg-dim; font-size: 12px; }
        HorizontalLayout {
            spacing: 6px;
            Choice { text: "15m"; minutes: 15; }
            Choice { text: "30m"; minutes: 30; }
            Choice { text: "1h"; minutes: 60; }
            Choice { text: "2h"; minutes: 120; }
            Choice { text: "5h"; minutes: 300; }
            Choice { text: "∞"; minutes: 0; }
        }
    }
}
