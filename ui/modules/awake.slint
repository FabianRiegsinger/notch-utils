import { Palette, Icon, Pill } from "../components.slint";

export global AwakeState {
    in property <bool> on;
    in property <string> status: "Off";
    // -1 off, 0 until turned off, 1 = 15 min, 2 = 1 h
    in property <int> mode: -1;
    // minutes: 0 = until turned off, negative = off
    callback set(int);
}

export component AwakeView inherits HorizontalLayout {
    alignment: center;
    spacing: 36px;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 120px;
            height: 120px;
            border-radius: 60px;
            background: AwakeState.on ? Palette.yellow.with-alpha(0.18) : Palette.surface;
            drop-shadow-blur: AwakeState.on ? 30px : 0px;
            drop-shadow-color: Palette.yellow.with-alpha(0.35);
            animate background { duration: 250ms; }
            accessible-role: button;
            accessible-label: AwakeState.on ? "Turn Keep Awake off" : "Keep awake until turned off";
            accessible-action-default => { AwakeState.set(AwakeState.on ? -1 : 0); }
            Icon { width: 48px; height: 48px; name: "awake"; tint: AwakeState.on ? Palette.yellow : Palette.fg-dim; }
            TouchArea { mouse-cursor: pointer; clicked => { AwakeState.set(AwakeState.on ? -1 : 0); } }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text { text: "Keep Awake"; color: Palette.fg; font-size: 17px; font-weight: 600; }
        Text { text: AwakeState.status; color: AwakeState.on ? Palette.yellow : Palette.fg-dim; font-size: 13px; }
        HorizontalLayout {
            spacing: 6px;
            Pill { text: "15 min"; active: AwakeState.mode == 1; clicked => { AwakeState.set(15); } }
            Pill { text: "1 h"; active: AwakeState.mode == 2; clicked => { AwakeState.set(60); } }
            Pill { text: "Until off"; active: AwakeState.mode == 0; clicked => { AwakeState.set(0); } }
            if AwakeState.on: Pill { text: "Turn off"; clicked => { AwakeState.set(-1); } }
        }
        Text {
            text: "Stops the computer and display from sleeping while on.";
            color: Palette.fg-faint;
            font-size: 11px;
        }
    }
}
