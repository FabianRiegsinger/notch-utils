import { Palette, Pill, Icon, Ring } from "../components.slint";

export global TimerState {
    in property <string> display: "05:00";
    in property <bool> running;
    in property <bool> stopwatch;
    // Ring fill 0..1: remaining (timer) or seconds of the minute (stopwatch).
    in property <float> progress: 1;
    // "5 min timer" / "Stopwatch", and "Ends at 12:07" while a timer runs.
    in property <string> label: "5 min timer";
    in property <string> ends;
    callback start-pause();
    callback reset();
    callback add-minutes(int);
    callback set-stopwatch(bool);
}

// Round icon button: white primary (play/pause) or dark secondary.
export component RoundIcon inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary;
    in property <length> size: 34px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.primary ? (touch.has-hover ? #e5e5ea : #fff) : (touch.has-hover ? Palette.surface-hover : Palette.surface);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { width: root.size * 0.38; height: root.size * 0.38; name: root.icon; tint: root.primary ? #000 : Palette.fg; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component TimerView inherits HorizontalLayout {
    spacing: 20px;
    padding-left: 8px;
    padding-right: 8px;

    VerticalLayout {
        alignment: center;
        Ring {
            width: 96px;
            height: 96px;
            thickness: 7px;
            progress: TimerState.progress;
            tint: Palette.orange;
            Icon { width: 30px; height: 30px; name: "timer"; tint: Palette.fg; }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 0px;
        Text { text: TimerState.label; color: Palette.fg-dim; font-size: 13px; }
        Text { text: TimerState.display; color: Palette.fg; font-size: 40px; font-weight: 700; accessible-role: text; }
        Text { text: TimerState.ends; color: Palette.fg-dim; font-size: 12px; }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Pill { text: TimerState.stopwatch ? "Timer" : "Stopwatch"; font-size: 12px; clicked => { TimerState.set-stopwatch(!TimerState.stopwatch); } }
        }
        if !TimerState.stopwatch: VerticalLayout {
            alignment: center;
            Pill { text: "+1 min"; font-size: 12px; clicked => { TimerState.add-minutes(1); } }
        }
        if !TimerState.stopwatch: VerticalLayout {
            alignment: center;
            Pill { text: "+5 min"; font-size: 12px; clicked => { TimerState.add-minutes(5); } }
        }
        VerticalLayout {
            alignment: center;
            RoundIcon {
                primary: true;
                size: 44px;
                icon: TimerState.running ? "pause" : "play";
                label: TimerState.running ? "Pause" : "Start";
                clicked => { TimerState.start-pause(); }
            }
        }
        VerticalLayout {
            alignment: center;
            RoundIcon { icon: "close"; label: "Reset"; size: 32px; clicked => { TimerState.reset(); } }
        }
    }
}
