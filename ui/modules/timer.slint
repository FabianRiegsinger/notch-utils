import { Palette, Pill, Icon, Ring } from "../components.slint";

export global TimerState {
    in property <string> display: "05:00";
    in property <bool> running;
    in property <bool> stopwatch;
    // Ring fill 0..1: remaining (timer) or seconds of the minute (stopwatch).
    in property <float> progress: 1;
    callback start-pause();
    callback reset();
    callback add-minutes(int);
    callback set-stopwatch(bool);
}

// Two-option segmented control.
component Segmented inherits Rectangle {
    in property <string> left;
    in property <string> right;
    in property <bool> right-active;
    callback changed(bool);
    height: 30px;
    width: 200px;
    border-radius: 9px;
    background: Palette.surface;
    knob := Rectangle {
        x: root.right-active ? parent.width / 2 + 1px : 2px;
        y: 2px;
        width: parent.width / 2 - 3px;
        height: parent.height - 4px;
        border-radius: 7px;
        background: Palette.surface-hover;
        animate x { duration: 200ms; easing: ease-out; }
    }
    HorizontalLayout {
        Rectangle {
            Text { text: root.left; color: !root.right-active ? Palette.fg : Palette.fg-dim; font-size: 12px; font-weight: 600; }
            TouchArea { clicked => { root.changed(false); } }
        }
        Rectangle {
            Text { text: root.right; color: root.right-active ? Palette.fg : Palette.fg-dim; font-size: 12px; font-weight: 600; }
            TouchArea { clicked => { root.changed(true); } }
        }
    }
}

component Action inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 36px;
    width: 104px;
    border-radius: 18px;
    background: root.primary ? (touch.has-hover ? Palette.orange.brighter(0.1) : Palette.orange) : (touch.has-hover ? Palette.surface-hover : Palette.surface);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Icon { width: 13px; height: 13px; y: (parent.height - self.height) / 2; name: root.icon; tint: root.primary ? #000 : Palette.fg; }
        Text { text: root.text; color: root.primary ? #000 : Palette.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component TimerView inherits HorizontalLayout {
    alignment: center;
    spacing: 36px;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 168px;
            height: 168px;
            border-radius: 84px;
            background: #000;
            drop-shadow-blur: TimerState.running ? 30px : 0px;
            drop-shadow-color: Palette.orange.with-alpha(0.3);
            Ring {
                width: 168px;
                height: 168px;
                thickness: 7px;
                progress: TimerState.progress;
                tint: TimerState.running ? Palette.orange : Palette.fg-faint;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: TimerState.display;
                        color: Palette.fg;
                        font-size: 36px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        accessible-role: text;
                    }
                    Text {
                        text: TimerState.stopwatch ? "Stopwatch" : (TimerState.running ? "Running" : "Timer");
                        color: Palette.fg-dim;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        Segmented {
            left: "Timer";
            right: "Stopwatch";
            right-active: TimerState.stopwatch;
            changed(sw) => { TimerState.set-stopwatch(sw); }
        }
        if !TimerState.stopwatch: HorizontalLayout {
            spacing: 6px;
            Pill { text: "−1m"; clicked => { TimerState.add-minutes(-1); } }
            Pill { text: "+1m"; clicked => { TimerState.add-minutes(1); } }
            Pill { text: "+5m"; clicked => { TimerState.add-minutes(5); } }
            Pill { text: "+15m"; clicked => { TimerState.add-minutes(15); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Action {
                primary: true;
                icon: TimerState.running ? "pause" : "play";
                text: TimerState.running ? "Pause" : "Start";
                clicked => { TimerState.start-pause(); }
            }
            Action { icon: "reset"; text: "Reset"; clicked => { TimerState.reset(); } }
        }
    }
}
