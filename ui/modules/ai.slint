import { Palette, Pill, Icon } from "../components.slint";

export global AiState {
    in property <bool> connected;
    in property <bool> has-data;
    // Percent used 0..100; negative = unknown.
    in property <float> five-pct: -1;
    in property <string> five-reset;
    in property <float> week-pct: -1;
    in property <string> week-reset;
    in property <string> as-of;
    in property <string> error;
    callback connect();
    callback disconnect();
}

component Meter inherits VerticalLayout {
    in property <string> title;
    in property <float> pct;
    in property <string> sub;
    property <color> tint: root.pct >= 90 ? Palette.red : root.pct >= 75 ? Palette.orange : Palette.fg;
    spacing: 5px;
    HorizontalLayout {
        Text { text: root.title; color: Palette.fg; font-size: 13px; font-weight: 500; horizontal-stretch: 1; }
        Text { text: root.pct < 0 ? "–" : Math.round(root.pct) + "%"; color: root.pct >= 75 ? root.tint : Palette.fg; font-size: 13px; font-weight: 600; }
    }
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Palette.surface-hover;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.pct / 100, 0, 1);
            border-radius: 2px;
            background: root.tint;
        }
    }
    Text { text: root.sub; color: Palette.fg-dim; font-size: 11px; }
}

export component AiView inherits HorizontalLayout {
    spacing: 10px;

    Rectangle {
        horizontal-stretch: 1;
        background: Palette.surface;
        border-radius: 14px;
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 6px;
                Icon { width: 15px; height: 15px; y: (parent.height - 15px) / 2; name: "ai"; tint: #d97757; }
                Text { text: "Claude Code"; color: Palette.fg; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: AiState.as-of; color: Palette.fg-dim; font-size: 11px; vertical-alignment: center; }
            }
            if AiState.has-data: Meter { title: "5 hours"; pct: AiState.five-pct; sub: AiState.five-reset; }
            if AiState.has-data: Meter { title: "This week"; pct: AiState.week-pct; sub: AiState.week-reset; }
            if !AiState.has-data: Text {
                text: AiState.connected
                    ? "Connected. Usage appears after Claude Code's next response (claude.ai Pro, Max or Ultra plans only)."
                    : "Shows your Claude plan's 5-hour and weekly usage, read from Claude Code's status line.";
                color: Palette.fg-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if AiState.error != "": Text { text: AiState.error; color: Palette.red; font-size: 11px; wrap: word-wrap; }
        }
    }

    VerticalLayout {
        alignment: end;
        if !AiState.connected: Pill { text: "Connect Claude Code"; active: true; font-size: 12px; clicked => { AiState.connect(); } }
        if AiState.connected: Pill { text: "Disconnect"; font-size: 12px; clicked => { AiState.disconnect(); } }
    }
}
