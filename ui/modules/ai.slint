import { Palette, Pill } from "../components.slint";

export global AiState {
    in property <bool> connected;
    in property <bool> has-data;
    // Percent used 0..100; negative = unknown.
    in property <float> five-pct: -1;
    in property <string> five-reset;
    in property <float> week-pct: -1;
    in property <string> week-reset;
    in property <string> as-of;
    in property <string> error;
    callback connect();
    callback disconnect();
}

component Meter inherits VerticalLayout {
    in property <string> title;
    in property <float> pct;
    in property <string> sub;
    spacing: 4px;
    HorizontalLayout {
        Text { text: root.title; color: Palette.fg; font-size: 13px; horizontal-stretch: 1; }
        Text { text: root.pct < 0 ? "–" : Math.round(root.pct) + "%"; color: root.pct >= 90 ? #ff453a : Palette.fg; font-size: 13px; font-weight: 600; }
    }
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Palette.surface-hover;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.pct / 100, 0, 1);
            border-radius: 4px;
            background: root.pct >= 90 ? Palette.red : root.pct >= 75 ? Palette.orange : Palette.purple;
        }
    }
    Text { text: root.sub; color: Palette.fg-dim; font-size: 11px; }
}

export component AiView inherits VerticalLayout {
    spacing: 12px;
    alignment: center;

    if AiState.has-data: Meter { title: "Claude · current session (5 h)"; pct: AiState.five-pct; sub: AiState.five-reset; }
    if AiState.has-data: Meter { title: "Claude · this week"; pct: AiState.week-pct; sub: AiState.week-reset; }

    if !AiState.has-data: Text {
        text: AiState.connected
            ? "Connected. Usage appears after Claude Code's next response (claude.ai Pro, Max or Ultra plans only)."
            : "Shows your Claude plan's 5-hour and weekly usage, read from Claude Code's status line.";
        color: Palette.fg-dim;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    if AiState.error != "": Text { text: AiState.error; color: #ff453a; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if AiState.as-of != "": Text { text: AiState.as-of; color: Palette.fg-dim; font-size: 11px; vertical-alignment: center; }
        if !AiState.connected: Pill { text: "Connect Claude Code"; active: true; clicked => { AiState.connect(); } }
        if AiState.connected: Pill { text: "Disconnect"; clicked => { AiState.disconnect(); } }
    }
}
