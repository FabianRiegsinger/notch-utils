import { Palette, Icon } from "../components.slint";

export struct NoteRow {
    id: int,
    title: string,
    // "Today · second line"
    sub: string,
    pinned: bool,
    selected: bool,
}

export global NotesState {
    in property <[NoteRow]> notes;
    in property <int> count;
    in property <bool> has-selection;
    in property <bool> pinned;
    // Editor text of the selected note; Rust replaces it on select, the editor on typing.
    in-out property <string> body;
    callback select(int);
    callback create();
    callback edited(string);
    callback toggle-pin();
    callback delete();
}

component SmallButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Palette.fg-dim;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? Palette.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { width: 16px; height: 16px; name: root.icon; tint: root.tint; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component NotesView inherits HorizontalLayout {
    spacing: 12px;

    VerticalLayout {
        width: 210px;
        spacing: 4px;
        HorizontalLayout {
            padding-left: 8px;
            spacing: 6px;
            Text { text: "Notes"; color: Palette.fg; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            Text { text: NotesState.count; color: Palette.fg-dim; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
            SmallButton {
                icon: "compose";
                label: "New note";
                clicked => {
                    NotesState.create();
                    editor.focus();
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                spacing: 2px;
                for n in NotesState.notes: Rectangle {
                    height: 46px;
                    border-radius: 10px;
                    background: n.selected ? Palette.surface-hover : touch.has-hover ? Palette.surface : transparent;
                    accessible-role: button;
                    accessible-label: n.title;
                    accessible-action-default => { NotesState.select(n.id); }
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 5px;
                            if n.pinned: Icon { width: 11px; height: 11px; y: (parent.height - 11px) / 2; name: "pin"; tint: Palette.fg; }
                            Text { text: n.title; color: Palette.fg; font-size: 14px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                        }
                        Text { text: n.sub; color: Palette.fg-dim; font-size: 12px; overflow: elide; }
                    }
                    touch := TouchArea { clicked => { NotesState.select(n.id); } }
                }
                if NotesState.count == 0: Text {
                    text: "No notes yet";
                    color: Palette.fg-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    Rectangle {
        horizontal-stretch: 1;
        background: Palette.surface;
        border-radius: 18px;
        clip: true;

        if !NotesState.has-selection: Text {
            text: "No note selected. Start one with the button above the list.";
            color: Palette.fg-dim;
            font-size: 13px;
        }

        // Click anywhere in the card to type.
        TouchArea { clicked => { editor.focus(); } mouse-cursor: text; }

        VerticalLayout {
            padding: 14px;
            padding-left: 16px;
            spacing: 6px;
            visible: NotesState.has-selection;
            Flickable {
                vertical-stretch: 1;
                content-height: max(editor.preferred-height, self.height);
                editor := TextInput {
                    width: parent.width;
                    height: max(self.preferred-height, parent.height);
                    single-line: false;
                    wrap: word-wrap;
                    text <=> NotesState.body;
                    color: Palette.fg;
                    font-size: 15px;
                    selection-background-color: Palette.accent.with-alpha(0.5);
                    edited => { NotesState.edited(self.text); }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                Text { text: "Saved as you type"; color: Palette.fg-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                SmallButton {
                    icon: "pin";
                    label: NotesState.pinned ? "Unpin note" : "Pin note";
                    tint: NotesState.pinned ? Palette.fg : Palette.fg-dim;
                    clicked => { NotesState.toggle-pin(); }
                }
                SmallButton { icon: "trash"; label: "Delete note"; clicked => { NotesState.delete(); } }
            }
        }
    }
}
