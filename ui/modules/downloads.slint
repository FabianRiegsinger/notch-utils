import { Palette, Icon } from "../components.slint";

export struct DlEntry {
    name: string,
    meta: string,
    // In progress (no actions).
    active: bool,
    // Index into the finished list.
    index: int,
}

export global DlState {
    in property <[DlEntry]> entries;
    in property <bool> available: true;
    in property <bool> can-drag;
    callback open(int);
    callback reveal(int);
    callback drag(int);
}

component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 22px;
    width: label.preferred-width + 14px;
    border-radius: 11px;
    background: touch.has-hover ? Palette.surface-hover : transparent;
    label := Text { text: root.text; color: Palette.fg-dim; font-size: 11px; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Row inherits Rectangle {
    in property <DlEntry> entry;
    property <bool> dragged;
    height: 44px;
    border-radius: 10px;
    background: touch.has-hover && !root.entry.active ? Palette.surface-hover : Palette.surface;
    accessible-role: button;
    accessible-label: root.entry.name;
    accessible-action-default => { DlState.open(root.entry.index); }
    touch := TouchArea {
        enabled: !root.entry.active;
        pointer-event(e) => { if e.kind == PointerEventKind.down { root.dragged = false; } }
        moved => {
            if DlState.can-drag && self.pressed && !root.dragged
                && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragged = true;
                DlState.drag(root.entry.index);
            }
        }
        double-clicked => { DlState.open(root.entry.index); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 10px;
        Icon {
            width: 18px;
            y: (parent.height - 18px) / 2;
            height: 18px;
            name: root.entry.active ? "download" : "file";
            tint: root.entry.active ? Palette.teal : Palette.fg-dim;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Palette.fg; font-size: 12px; overflow: elide; }
            Text { text: root.entry.meta; color: root.entry.active ? Palette.teal : Palette.fg-dim; font-size: 10px; }
        }
        if !root.entry.active: LinkButton { y: (parent.height - self.height) / 2; text: "Show"; clicked => { DlState.reveal(root.entry.index); } }
        if !root.entry.active: LinkButton { y: (parent.height - self.height) / 2; text: "Open"; clicked => { DlState.open(root.entry.index); } }
    }
}

export component DownloadsView inherits VerticalLayout {
    spacing: 8px;
    if DlState.entries.length == 0: Text {
        vertical-stretch: 1;
        text: DlState.available ? "No downloads yet." : "No Downloads folder found.";
        color: Palette.fg-dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if DlState.entries.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            spacing: 4px;
            alignment: start;
            for e in DlState.entries: Row { entry: e; }
        }
    }
}
