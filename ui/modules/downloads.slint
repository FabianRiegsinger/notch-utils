import { Palette, Icon, IconButton } from "../components.slint";

export struct DlEntry {
    name: string,
    meta: string,
    // In progress (no actions).
    active: bool,
    // Index into the finished list.
    index: int,
}

export global DlState {
    in property <[DlEntry]> entries;
    in property <bool> available: true;
    in property <bool> can-drag;
    callback open(int);
    callback reveal(int);
    callback drag(int);
}

component Row inherits Rectangle {
    in property <DlEntry> entry;
    property <bool> dragged;
    height: 52px;
    border-radius: 12px;
    background: touch.has-hover && !root.entry.active ? Palette.surface : transparent;
    accessible-role: button;
    accessible-label: root.entry.name;
    accessible-action-default => { DlState.open(root.entry.index); }
    touch := TouchArea {
        enabled: !root.entry.active;
        pointer-event(e) => { if e.kind == PointerEventKind.down { root.dragged = false; } }
        moved => {
            if DlState.can-drag && self.pressed && !root.dragged
                && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragged = true;
                DlState.drag(root.entry.index);
            }
        }
        double-clicked => { DlState.open(root.entry.index); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        // Paper-white document like a Finder icon.
        Rectangle {
            width: 26px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: #f2f2f7;
            VerticalLayout {
                padding: 6px;
                padding-top: 8px;
                spacing: 3px;
                alignment: start;
                for _ in 4: Rectangle { height: 1.5px; background: #c7c7cc; }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.entry.name; color: Palette.fg; font-size: 14px; font-weight: 600; overflow: elide; }
            // In progress: the size isn't known in advance, so a moving bar instead of a percentage.
            if root.entry.active: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Palette.surface-hover;
                clip: true;
                Rectangle {
                    width: parent.width * 0.3;
                    x: (parent.width * 1.3) * mod(animation-tick() / 1.6s, 1) - self.width;
                    border-radius: 2px;
                    background: Palette.accent;
                }
            }
            Text { text: root.entry.meta; color: Palette.fg-dim; font-size: 11px; }
        }
        if !root.entry.active: IconButton { y: (parent.height - self.height) / 2; icon: "folder"; label: "Show in folder"; clicked => { DlState.reveal(root.entry.index); } }
        if !root.entry.active: IconButton { y: (parent.height - self.height) / 2; icon: "open"; label: "Open"; clicked => { DlState.open(root.entry.index); } }
    }
}

export component DownloadsView inherits VerticalLayout {
    spacing: 8px;
    if DlState.entries.length == 0: Text {
        vertical-stretch: 1;
        text: DlState.available ? "No downloads yet." : "No Downloads folder found.";
        color: Palette.fg-dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if DlState.entries.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            spacing: 4px;
            alignment: start;
            for e in DlState.entries: Row { entry: e; }
        }
    }
}
