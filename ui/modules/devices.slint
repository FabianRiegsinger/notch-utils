import { Palette, Icon, Card } from "../components.slint";

export struct DevEntry {
    name: string,
    icon: string,
    battery: string,
    low: bool,
}

export global DevState {
    in property <[DevEntry]> entries;
    in property <bool> supported: true;
}

export component DevicesView inherits VerticalLayout {
    spacing: 8px;
    if DevState.entries.length == 0: Text {
        vertical-stretch: 1;
        text: DevState.supported ? "No Bluetooth devices connected." : "Devices aren't available on Windows yet.";
        color: Palette.fg-dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if DevState.entries.length > 0: HorizontalLayout {
        spacing: 10px;
        alignment: center;
        for d in DevState.entries: Card {
            width: 150px;
            height: 150px;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: center;
                HorizontalLayout { alignment: center; Icon { width: 34px; height: 34px; name: d.icon; } }
                Text { text: d.name; color: Palette.fg; font-size: 12px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                Text {
                    text: d.battery;
                    color: d.low ? Palette.red : Palette.green;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
