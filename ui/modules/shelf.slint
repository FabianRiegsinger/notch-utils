import { Palette, Pill } from "../components.slint";

export struct ShelfEntry {
    id: int,
    name: string,
    meta: string,
    thumb: image,
    has-thumb: bool,
    is-dir: bool,
    missing: bool,
}

export global ShelfState {
    in property <[ShelfEntry]> entries;
    // True on macOS: rows can be dragged out to Finder.
    in property <bool> can-drag;
    callback copy(int);
    callback reveal(int);
    callback open(int);
    callback remove(int);
    callback clear();
    callback drag(int);
}

component TextButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 22px;
    width: label.preferred-width + 14px;
    border-radius: 11px;
    background: touch.has-hover ? Palette.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: Palette.fg-dim;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Row inherits Rectangle {
    in property <ShelfEntry> entry;
    // Set once a press turned into a drag, so the release doesn't also copy.
    property <bool> dragged;
    height: 44px;
    border-radius: 10px;
    background: touch.has-hover ? Palette.surface-hover : Palette.surface;
    opacity: root.entry.missing ? 0.5 : 1;
    accessible-role: button;
    accessible-label: "Copy " + root.entry.name;
    accessible-action-default => { ShelfState.copy(root.entry.id); }

    touch := TouchArea {
        mouse-cursor: ShelfState.can-drag ? grab : pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dragged = false;
            }
        }
        moved => {
            if ShelfState.can-drag && self.pressed && !root.dragged
                && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragged = true;
                ShelfState.drag(root.entry.id);
            }
        }
        clicked => {
            if !root.dragged {
                ShelfState.copy(root.entry.id);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 8px;
        alignment: stretch;
        Rectangle {
            width: 32px;
            if root.entry.has-thumb: Image {
                width: 32px;
                height: 32px;
                source: root.entry.thumb;
                image-fit: cover;
            }
            if !root.entry.has-thumb: Image {
                width: 22px;
                height: 22px;
                colorize: Palette.fg-dim;
                source: root.entry.is-dir ? @image-url("../../assets/icons/folder.svg") : @image-url("../../assets/icons/file.svg");
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Palette.fg; font-size: 12px; overflow: elide; }
            Text { text: root.entry.missing ? "Moved or deleted" : root.entry.meta; color: Palette.fg-dim; font-size: 10px; overflow: elide; }
        }
        TextButton { y: (parent.height - self.height) / 2; text: "Show"; clicked => { ShelfState.reveal(root.entry.id); } }
        TextButton { y: (parent.height - self.height) / 2; text: "Open"; clicked => { ShelfState.open(root.entry.id); } }
        TextButton { y: (parent.height - self.height) / 2; text: "×"; clicked => { ShelfState.remove(root.entry.id); } }
    }
}

export component ShelfView inherits VerticalLayout {
    spacing: 8px;

    if ShelfState.entries.length == 0: Rectangle {
        vertical-stretch: 1;
        border-radius: 14px;
        border-width: 1.5px;
        border-color: Palette.surface-hover;
        Text {
            text: "Drop files here to keep them handy.\nClick one to copy it" + (ShelfState.can-drag ? ", or drag it out." : ", then paste it anywhere.");
            color: Palette.fg-dim;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if ShelfState.entries.length > 0: HorizontalLayout {
        Text {
            text: ShelfState.entries.length + (ShelfState.entries.length == 1 ? " file" : " files") + " · click to copy" + (ShelfState.can-drag ? ", drag to move out" : "");
            color: Palette.fg-dim;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Pill { text: "Clear"; clicked => { ShelfState.clear(); } }
    }

    if ShelfState.entries.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            spacing: 4px;
            alignment: start;
            for e in ShelfState.entries: Row { entry: e; }
        }
    }
}
