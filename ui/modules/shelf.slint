import { Palette, IconButton } from "../components.slint";

export struct ShelfEntry {
    id: int,
    name: string,
    meta: string,
    thumb: image,
    has-thumb: bool,
    is-dir: bool,
    missing: bool,
}

export global ShelfState {
    in property <[ShelfEntry]> entries;
    // True on macOS: rows can be dragged out to Finder.
    in property <bool> can-drag;
    callback copy(int);
    callback reveal(int);
    callback open(int);
    callback remove(int);
    callback clear();
    callback drag(int);
    // Selected tile (its id); -1 = none.
    in-out property <int> selected: -1;
    in property <string> summary;
}

component Tile inherits Rectangle {
    in property <ShelfEntry> entry;
    property <bool> dragged;
    property <bool> sel: ShelfState.selected == root.entry.id;
    width: 84px;
    height: 92px;
    border-radius: 12px;
    background: root.sel ? Palette.surface-hover : touch.has-hover ? Palette.surface : transparent;
    opacity: root.entry.missing ? 0.5 : 1;
    accessible-role: button;
    accessible-label: root.entry.name;
    accessible-action-default => { ShelfState.selected = root.entry.id; }

    touch := TouchArea {
        mouse-cursor: ShelfState.can-drag ? grab : pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dragged = false;
            }
        }
        moved => {
            if ShelfState.can-drag && self.pressed && !root.dragged
                && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragged = true;
                ShelfState.drag(root.entry.id);
            }
        }
        clicked => {
            if !root.dragged {
                ShelfState.selected = root.entry.id;
            }
        }
        double-clicked => { ShelfState.open(root.entry.id); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 8px;
                clip: true;
                if root.entry.has-thumb: Image { width: 100%; height: 100%; source: root.entry.thumb; image-fit: cover; }
                if !root.entry.has-thumb: Image {
                    width: 44px;
                    height: 44px;
                    colorize: root.entry.is-dir ? Palette.teal : Palette.fg-dim;
                    source: root.entry.is-dir ? @image-url("../../assets/icons/folder.svg") : @image-url("../../assets/icons/file.svg");
                }
            }
        }
        Text {
            text: root.entry.missing ? "Moved" : root.entry.name;
            color: Palette.fg;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component ShelfView inherits VerticalLayout {
    spacing: 8px;

    if ShelfState.entries.length == 0: Rectangle {
        vertical-stretch: 1;
        border-radius: 14px;
        border-width: 1.5px;
        border-color: Palette.surface-hover;
        Text {
            text: "Drop files here to keep them handy." + (ShelfState.can-drag ? "\nDrag them out again when you need them." : "");
            color: Palette.fg-dim;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if ShelfState.entries.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: tiles.preferred-width;
        tiles := HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for e in ShelfState.entries: Tile { entry: e; }
        }
    }

    if ShelfState.entries.length > 0: HorizontalLayout {
        spacing: 8px;
        Text {
            text: ShelfState.summary + (ShelfState.can-drag ? " · drag out to copy" : "");
            color: Palette.fg-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if ShelfState.selected >= 0: IconButton { icon: "clipboard"; label: "Copy"; clicked => { ShelfState.copy(ShelfState.selected); } }
        if ShelfState.selected >= 0: IconButton { icon: "folder"; label: "Show in folder"; clicked => { ShelfState.reveal(ShelfState.selected); } }
        if ShelfState.selected >= 0: IconButton { icon: "open"; label: "Open"; clicked => { ShelfState.open(ShelfState.selected); } }
        if ShelfState.selected >= 0: IconButton {
            icon: "trash";
            label: "Remove from shelf";
            clicked => {
                ShelfState.remove(ShelfState.selected);
                ShelfState.selected = -1;
            }
        }
        Rectangle { width: 1px; height: 20px; y: (parent.height - 20px) / 2; background: Palette.separator; }
        IconButton {
            icon: "close";
            label: "Clear shelf";
            clicked => {
                ShelfState.clear();
                ShelfState.selected = -1;
            }
        }
    }
}
