import { Palette, Icon } from "../components.slint";

export global ColorState {
    in property <color> color: #0a6fe8;
    in property <string> hex;
    in property <string> rgb;
    in property <string> hsl;
    // Newest first; the first one is the current color.
    in property <[color]> recent;
    // Row just copied (0 hex, 1 rgb, 2 hsl), -1 none.
    in property <int> copied: -1;
    // Screen sampling is macOS-only.
    in property <bool> can-pick: true;
    callback pick();
    callback copy(int);
    callback choose(int);
    callback clear();
}

component ValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> index;
    height: 32px;
    border-radius: 10px;
    background: Palette.surface;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 12px;
        Text { text: root.label; width: 34px; color: Palette.fg-dim; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        Text { text: root.value; color: Palette.fg; font-size: 14px; font-family: "Menlo"; vertical-alignment: center; horizontal-stretch: 1; }
        if ColorState.copied == root.index: Text { text: "Copied"; color: Palette.green; font-size: 11px; font-weight: 600; vertical-alignment: center; }
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - 26px) / 2;
            border-radius: 8px;
            background: touch.has-hover ? Palette.surface-hover : transparent;
            accessible-role: button;
            accessible-label: "Copy " + root.label;
            accessible-action-default => { ColorState.copy(root.index); }
            Icon { width: 14px; height: 14px; name: "copy"; tint: Palette.fg-dim; }
            touch := TouchArea { mouse-cursor: pointer; clicked => { ColorState.copy(root.index); } }
        }
    }
}

export component ColorView inherits HorizontalLayout {
    spacing: 18px;
    padding-left: 8px;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        Rectangle {
            width: 74px;
            height: 74px;
            border-radius: 18px;
            background: ColorState.color;
            border-width: 1px;
            border-color: #ffffff22;
        }
        if ColorState.can-pick: Rectangle {
            width: 74px;
            height: 28px;
            border-radius: 14px;
            background: pick-touch.pressed ? Palette.accent.darker(0.2) : pick-touch.has-hover ? Palette.accent.brighter(0.15) : Palette.accent;
            accessible-role: button;
            accessible-label: "Pick a color from the screen";
            accessible-action-default => { ColorState.pick(); }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Icon { width: 12px; height: 12px; y: (parent.height - 12px) / 2; name: "eyedropper"; }
                Text { text: "Pick"; color: #fff; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            }
            pick-touch := TouchArea { mouse-cursor: pointer; clicked => { ColorState.pick(); } }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 6px;
        ValueRow { label: "HEX"; value: ColorState.hex; index: 0; }
        ValueRow { label: "RGB"; value: ColorState.rgb; index: 1; }
        ValueRow { label: "HSL"; value: ColorState.hsl; index: 2; }
    }

    VerticalLayout {
        alignment: center;
        Rectangle { width: 1px; height: 46px; background: Palette.separator; }
    }

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        width: 150px;
        HorizontalLayout {
            Text { text: "Recent"; color: Palette.fg-dim; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
            Text {
                text: "Clear";
                color: clear-touch.has-hover ? Palette.fg : Palette.fg-dim;
                font-size: 12px;
                font-weight: 600;
                clear-touch := TouchArea { mouse-cursor: pointer; clicked => { ColorState.clear(); } }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 7px;
            for c[i] in ColorState.recent: Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: i == 0 ? 2px : 0px;
                border-color: #fff;
                accessible-role: button;
                accessible-label: "Use recent color " + (i + 1);
                accessible-action-default => { ColorState.choose(i); }
                Rectangle {
                    width: i == 0 ? 16px : 22px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: c;
                }
                TouchArea { mouse-cursor: pointer; clicked => { ColorState.choose(i); } }
            }
        }
    }
}
