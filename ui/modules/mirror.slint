import { Palette, Icon } from "../components.slint";

export global MirrorState {
    in property <image> frame;
    // "off", "starting", "live", "denied", "none"
    in property <string> status: "off";
}

export component MirrorView inherits HorizontalLayout {
    spacing: 16px;
    Rectangle {
        width: min(parent.width * 0.4, parent.height * 4 / 3);
        border-radius: 14px;
        background: Palette.surface;
        clip: true;
        if MirrorState.status == "live": Image {
            width: 100%;
            height: 100%;
            source: MirrorState.frame;
            image-fit: cover;
            accessible-role: image;
            accessible-label: "Camera preview";
        }
        if MirrorState.status != "live": VerticalLayout {
            alignment: center;
            padding: 12px;
            spacing: 8px;
            HorizontalLayout { alignment: center; Icon { width: 26px; height: 26px; name: "mirror"; tint: Palette.fg-dim; } }
            Text {
                text: MirrorState.status == "denied"
                    ? "Camera access is off. Allow it in System Settings → Privacy & Security → Camera."
                    : MirrorState.status == "none" ? "No camera found." : "Starting camera…";
                color: Palette.fg-dim;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 8px;
        Rectangle {
            height: 36px;
            border-radius: 10px;
            background: Palette.surface;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Icon { width: 15px; height: 15px; y: (parent.height - 15px) / 2; name: "mirror"; }
                Text { text: "Built-in camera"; color: Palette.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "✓"; color: Palette.fg; font-size: 13px; vertical-alignment: center; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Rectangle {
                height: 30px;
                width: mirrored.preferred-width + 28px;
                border-radius: 15px;
                background: Palette.accent;
                mirrored := Text { text: "Mirrored"; color: #fff; font-size: 13px; font-weight: 600; }
            }
            Text { text: "Nothing is recorded"; color: Palette.fg-dim; font-size: 12px; vertical-alignment: center; }
        }
    }
}
