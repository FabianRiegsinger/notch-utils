import { Palette, Icon } from "../components.slint";

export global MirrorState {
    in property <image> frame;
    // "off", "starting", "live", "denied", "none"
    in property <string> status: "off";
}

export component MirrorView inherits HorizontalLayout {
    alignment: center;
    Rectangle {
        width: min(parent.width, (parent.height) * 16 / 9);
        border-radius: 18px;
        background: Palette.surface;
        clip: true;
        if MirrorState.status == "live": Image {
            width: 100%;
            height: 100%;
            source: MirrorState.frame;
            image-fit: cover;
            accessible-role: image;
            accessible-label: "Camera preview";
        }
        if MirrorState.status != "live": VerticalLayout {
            alignment: center;
            spacing: 8px;
            HorizontalLayout { alignment: center; Icon { width: 28px; height: 28px; name: "mirror"; tint: Palette.fg-dim; } }
            Text {
                text: MirrorState.status == "denied"
                    ? "Camera access is off. Allow it in System Settings → Privacy & Security → Camera."
                    : MirrorState.status == "none" ? "No camera found." : "Starting camera…";
                color: Palette.fg-dim;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
