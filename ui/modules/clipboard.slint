import { Palette, Pill } from "../components.slint";

export struct ClipEntry {
    id: int,
    text: string,
    meta: string,
    is-image: bool,
    image: image,
    pinned: bool,
}

export global ClipState {
    in property <[ClipEntry]> entries;
    in property <int> total;
    in property <bool> enabled;
    callback copy(int);
    callback toggle-pin(int);
    callback remove(int);
    callback clear();
    callback search(string);
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: touch.has-hover ? Palette.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.icon;
        color: root.on ? Palette.accent : Palette.fg-dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Row inherits Rectangle {
    in property <ClipEntry> entry;
    border-radius: 10px;
    background: touch.pressed ? Palette.surface-hover.brighter(0.2) : touch.has-hover ? Palette.surface-hover : Palette.surface;
    height: root.entry.is-image ? 76px : 34px;
    accessible-role: button;
    accessible-label: root.entry.is-image ? "Image " + root.entry.meta : root.entry.text;
    accessible-action-default => { ClipState.copy(root.entry.id); }

    // Behind the buttons: a click anywhere else copies.
    touch := TouchArea { clicked => { ClipState.copy(root.entry.id); } }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;
        if !root.entry.is-image: Text {
            text: root.entry.text;
            color: Palette.fg;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.entry.is-image: Rectangle {
            horizontal-stretch: 1;
            Image {
                x: 0;
                height: parent.height - 12px;
                source: root.entry.image;
                image-fit: contain;
                horizontal-alignment: left;
            }
        }
        Text {
            text: root.entry.meta;
            color: Palette.fg-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: root.entry.pinned ? "★" : "☆";
            label: root.entry.pinned ? "Unpin" : "Pin";
            on: root.entry.pinned;
            clicked => { ClipState.toggle-pin(root.entry.id); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: "×";
            label: "Remove";
            clicked => { ClipState.remove(root.entry.id); }
        }
    }
}

export component ClipboardView inherits VerticalLayout {
    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 28px;
            border-radius: 14px;
            background: Palette.surface;
            horizontal-stretch: 1;
            search := TextInput {
                x: 12px;
                width: parent.width - 24px;
                vertical-alignment: center;
                color: Palette.fg;
                font-size: 12px;
                single-line: true;
                accessible-role: text-input;
                accessible-label: "Search clipboard history";
                edited => { ClipState.search(self.text); }
            }
            if search.text == "": Text {
                x: 12px;
                vertical-alignment: center;
                text: "Search " + ClipState.total + (ClipState.total == 1 ? " item" : " items");
                color: Palette.fg-dim;
                font-size: 12px;
            }
        }
        Pill { text: "Clear"; clicked => { ClipState.clear(); } }
    }

    if ClipState.entries.length == 0: Text {
        vertical-stretch: 1;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Palette.fg-dim;
        font-size: 12px;
        text: search.text != "" ? "No matches" : "Copy something: it shows up here. Click an item to copy it again.";
    }

    if ClipState.entries.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            spacing: 4px;
            alignment: start;
            for e in ClipState.entries: Row { entry: e; }
        }
    }
}
