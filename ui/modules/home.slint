import { Palette, Icon, Card, Ring } from "../components.slint";
import { TimerState } from "timer.slint";
import { CalState, WeekStrip } from "calendar.slint";
import { MusicState, Cover, Controls } from "music.slint";

export global HomeState {
    in property <string> date;
    in property <bool> has-battery;
    in property <int> battery-pct;
    in property <bool> charging;
}

component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Palette.fg;
    in property <color> base: Palette.surface-hover;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: touch.pressed ? root.base.brighter(0.3) : touch.has-hover ? root.base.brighter(0.15) : root.base;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { width: 14px; height: 14px; name: root.icon; tint: root.tint; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Battery glyph with the charge level, then the percent below (green; red when low).
component BatteryBadge inherits VerticalLayout {
    property <bool> low: !HomeState.charging && HomeState.battery-pct <= 20;
    property <color> tint: root.low ? Palette.red : Palette.green;
    alignment: center;
    spacing: 6px;
    HorizontalLayout {
        alignment: center;
        spacing: 1px;
        Rectangle {
            width: 30px;
            height: 15px;
            border-radius: 4px;
            border-width: 1.5px;
            border-color: Palette.fg-dim;
            Rectangle {
                x: 2.5px;
                y: 2.5px;
                height: parent.height - 5px;
                width: (parent.width - 5px) * clamp(HomeState.battery-pct / 100, 0, 1);
                border-radius: 2px;
                background: root.tint;
            }
            if HomeState.charging: Icon { width: 11px; height: 11px; name: "bolt"; tint: #fff; }
        }
        Rectangle { width: 2px; height: 6px; y: (parent.height - 6px) / 2; border-radius: 1px; background: Palette.fg-dim; }
    }
    Text { text: HomeState.battery-pct + "%"; color: root.tint; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
}

export component HomeView inherits HorizontalLayout {
    spacing: 20px;
    padding-left: 4px;
    padding-right: 4px;

    // Now Playing (while a track is loaded), otherwise the timer.
    if MusicState.has-track: HorizontalLayout {
        width: 300px;
        spacing: 14px;
        VerticalLayout { alignment: center; Cover { size: 96px; } }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: MusicState.title; color: Palette.fg; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: MusicState.artist; color: Palette.fg-dim; font-size: 13px; overflow: elide; }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Palette.surface-hover;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(MusicState.progress, 0, 1);
                    border-radius: 2px;
                    background: Palette.fg;
                    animate width { duration: 900ms; }
                }
            }
            HorizontalLayout { alignment: start; Controls { spacing-x: 6px; icon-size: 16px; } }
        }
    }

    if !MusicState.has-track: HorizontalLayout {
        width: 300px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Ring {
                width: 84px;
                height: 84px;
                thickness: 6px;
                progress: TimerState.progress;
                tint: Palette.orange;
                Icon { width: 26px; height: 26px; name: "timer"; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text { text: TimerState.display; color: Palette.fg; font-size: 30px; font-weight: 700; }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                RoundButton {
                    icon: TimerState.running ? "pause" : "play";
                    label: TimerState.running ? "Pause timer" : "Start timer";
                    base: #fff;
                    tint: #000;
                    clicked => { TimerState.start-pause(); }
                }
                RoundButton { icon: "close"; label: "Reset timer"; clicked => { TimerState.reset(); } }
            }
        }
    }

    Rectangle { width: 1px; background: Palette.separator; }

    // Week, battery and the next event
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 12px;
        HorizontalLayout {
            spacing: 14px;
            WeekStrip { horizontal-stretch: 1; }
            if HomeState.has-battery: Rectangle { width: 1px; background: Palette.separator; }
            if HomeState.has-battery: BatteryBadge { width: 64px; }
        }
        Card {
            height: 52px;
            border-radius: 14px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Rectangle {
                    width: 4px;
                    y: 10px;
                    height: parent.height - 20px;
                    border-radius: 2px;
                    background: CalState.has-next ? Palette.accent : Palette.fg-faint;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: CalState.has-next ? CalState.next-title : (CalState.configured ? "No upcoming events" : "Add a calendar in Settings");
                        color: CalState.has-next ? Palette.fg : Palette.fg-dim;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if CalState.has-next: Text {
                        text: CalState.next-when + (CalState.next-location != "" ? " · " + CalState.next-location : "");
                        color: Palette.fg-dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
