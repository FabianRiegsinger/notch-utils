import { Palette, Pill } from "components.slint";
import { TimerView, TimerState } from "modules/timer.slint";
import { SettingsWindow, ModuleEntry } from "settings.slint";
import { CalcView, CalcState } from "modules/calc.slint";
import { StatsView, StatsState, LabeledValue } from "modules/stats.slint";
import { ClipboardView, ClipState, ClipEntry } from "modules/clipboard.slint";
import { ShelfView, ShelfState, ShelfEntry } from "modules/shelf.slint";
import { AiView, AiState } from "modules/ai.slint";
import { CalendarView, CalState, CalEvent } from "modules/calendar.slint";
import { TermView, TermState, TermLine, TermRun } from "modules/terminal.slint";

export { Palette, TimerState, SettingsWindow, ModuleEntry, CalcState, StatsState, LabeledValue, ClipState, ClipEntry, ShelfState, ShelfEntry, AiState, CalState, CalEvent, TermState, TermLine, TermRun }

export enum NotchState { collapsed, peek, expanded }

export struct ModuleTab {
    id: string,
    title: string,
}

// Picks a module's full view by id. Adding a module = one line here.
component ModuleView {
    in property <string> id;
    if root.id == "timer": TimerView { }
    if root.id == "calc": CalcView { }
    if root.id == "stats": StatsView { }
    if root.id == "clipboard": ClipboardView { }
    if root.id == "shelf": ShelfView { }
    if root.id == "ai": AiView { }
    if root.id == "calendar": CalendarView { }
    if root.id == "terminal": TermView { }
}

export component NotchWindow inherits Window {
    title: "notch-utils";
    no-frame: true;
    always-on-top: root.on-top;
    background: transparent;

    in property <bool> on-top: true;
    in property <NotchState> state: NotchState.collapsed;
    // Shape size animates; the window itself is resized from Rust (grow first, shrink after).
    in property <length> shape-width: 160px;
    in property <length> shape-height: 24px;
    in property <color> shape-color: black;
    // Height hidden by the camera housing; content starts below it.
    in property <length> top-inset: 0px;
    in property <string> peek-text;
    // HUD (volume, battery) replaces the peek text while active.
    in property <bool> hud-active;
    in property <string> hud-icon;
    in property <float> hud-level: -1; // 0..1 for a bar, negative = no bar
    in property <string> hud-text;
    in property <bool> hud-warn;
    in property <[ModuleTab]> modules;
    in property <bool> grid;
    in-out property <int> active-tab;

    callback clicked();
    callback tab-changed(int);

    shape := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.shape-width;
        height: root.shape-height;
        background: root.shape-color;
        border-bottom-left-radius: root.state == NotchState.expanded ? 24px : min(self.height / 2, 12px);
        border-bottom-right-radius: self.border-bottom-left-radius;
        clip: true;

        animate width, height { duration: 260ms; easing: ease-out-back; }
        animate border-bottom-left-radius { duration: 200ms; }

        // Behind the content: catches clicks that no module control handled.
        TouchArea {
            clicked => { root.clicked(); }
        }

        if root.state == NotchState.peek && root.hud-active: HorizontalLayout {
            y: root.top-inset;
            height: parent.height - root.top-inset;
            width: parent.width;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 10px;
            Image {
                width: 18px;
                image-fit: contain;
                colorize: root.hud-warn ? #ff453a : Palette.fg;
                source: root.hud-icon == "muted" ? @image-url("../assets/icons/muted.svg")
                    : root.hud-icon == "bolt" ? @image-url("../assets/icons/bolt.svg")
                    : root.hud-icon == "battery" ? @image-url("../assets/icons/battery.svg")
                    : root.hud-icon == "battery-low" ? @image-url("../assets/icons/battery-low.svg")
                    : root.hud-icon == "timer" ? @image-url("../assets/icons/timer.svg")
                    : @image-url("../assets/icons/volume.svg");
            }
            if root.hud-level >= 0: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                horizontal-stretch: 1;
                border-radius: 3px;
                background: Palette.surface-hover;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.hud-level, 0, 1);
                    border-radius: 3px;
                    background: root.hud-warn ? #ff453a : Palette.fg;
                    animate width { duration: 120ms; }
                }
            }
            Text {
                text: root.hud-text;
                color: root.hud-warn ? #ff453a : Palette.fg;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: root.hud-level >= 0 ? 0 : 1;
                horizontal-alignment: root.hud-level >= 0 ? right : left;
            }
        }

        if root.state == NotchState.peek && !root.hud-active: Text {
            y: root.top-inset;
            height: parent.height - root.top-inset;
            width: parent.width;
            text: root.peek-text;
            color: Palette.fg;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.state == NotchState.expanded: VerticalLayout {
            padding: 14px;
            padding-top: max(root.top-inset, 10px) + 6px;
            spacing: 10px;

            if !root.grid && root.modules.length > 1: HorizontalLayout {
                alignment: center;
                spacing: 6px;
                for m[i] in root.modules: Pill {
                    text: m.title;
                    active: i == root.active-tab;
                    clicked => {
                        root.active-tab = i;
                        root.tab-changed(i);
                    }
                }
            }

            if root.modules.length == 0: Text {
                text: "No modules enabled. Open Settings from the tray icon.";
                color: Palette.fg-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
            }

            if !root.grid && root.modules.length > 0: ModuleView {
                id: root.modules[min(root.active-tab, root.modules.length - 1)].id;
                vertical-stretch: 1;
            }

            if root.grid: HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                for m in root.modules: Rectangle {
                    background: Palette.surface;
                    border-radius: 16px;
                    VerticalLayout {
                        padding: 10px;
                        Text { text: m.title; color: Palette.fg-dim; font-size: 11px; }
                        ModuleView { id: m.id; vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "notch-utils";

    callback toggle();
    callback open-settings();
    callback quit();

    Menu {
        MenuItem { title: "Toggle notch"; activated => { root.toggle(); } }
        MenuItem { title: "Settings…"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "Quit notch-utils"; activated => { root.quit(); } }
    }
}
