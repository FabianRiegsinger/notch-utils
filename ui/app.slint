import { Palette, Pill, Icon, Card } from "components.slint";
import { TimerView, TimerState } from "modules/timer.slint";
import { SettingsWindow, ModuleEntry, ModuleSet } from "settings.slint";
import { CalcView, CalcState } from "modules/calc.slint";
import { StatsView, StatsState, LabeledValue } from "modules/stats.slint";
import { ClipboardView, ClipState, ClipEntry } from "modules/clipboard.slint";
import { ShelfView, ShelfState, ShelfEntry } from "modules/shelf.slint";
import { AiView, AiState } from "modules/ai.slint";
import { CalendarView, CalState, CalEvent, CalDay } from "modules/calendar.slint";
import { TermView, TermState, TermLine, TermRun } from "modules/terminal.slint";
import { HomeView, HomeState } from "modules/home.slint";
import { MusicView, MusicState } from "modules/music.slint";
import { AwakeView, AwakeState } from "modules/awake.slint";
import { DownloadsView, DlState, DlEntry } from "modules/downloads.slint";
import { DevicesView, DevState, DevEntry } from "modules/devices.slint";
import { MirrorView, MirrorState } from "modules/mirror.slint";

export { Palette, TimerState, SettingsWindow, ModuleEntry, CalcState, StatsState, LabeledValue, ClipState, ClipEntry, ShelfState, ShelfEntry, AiState, CalState, CalEvent, TermState, TermLine, TermRun, HomeState, CalDay, ModuleSet, MusicState, AwakeState, DlState, DlEntry, DevState, DevEntry, MirrorState }

export enum NotchState { collapsed, peek, expanded }

export struct ModuleTab {
    id: string,
    title: string,
    // Position in the full module list (active-tab refers to it).
    index: int,
}

// Picks a module's full view by id. Adding a module = one line here.
component ModuleView {
    in property <string> id;
    if root.id == "home": HomeView { }
    if root.id == "music": MusicView { }
    if root.id == "awake": AwakeView { }
    if root.id == "downloads": DownloadsView { }
    if root.id == "devices": DevicesView { }
    if root.id == "mirror": MirrorView { }
    if root.id == "timer": TimerView { }
    if root.id == "calc": CalcView { }
    if root.id == "stats": StatsView { }
    if root.id == "clipboard": ClipboardView { }
    if root.id == "shelf": ShelfView { }
    if root.id == "ai": AiView { }
    if root.id == "calendar": CalendarView { }
    if root.id == "terminal": TermView { }
}

component TabIcon inherits Rectangle {
    in property <ModuleTab> tab;
    in property <bool> active;
    callback select(int);
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: root.active ? Palette.surface-hover : touch.has-hover ? Palette.surface : transparent;
    animate background { duration: 150ms; }
    accessible-role: AccessibleRole.tab;
    accessible-label: root.tab.title;
    accessible-action-default => { root.select(root.tab.index); }
    Icon {
        width: 15px;
        height: 15px;
        name: root.tab.id;
        tint: root.active ? Palette.fg : Palette.fg-dim;
    }
    touch := TouchArea { clicked => { root.select(root.tab.index); } }
}

// Live activity beside the notch: colored icon left of the camera, value right of it.
component Activity inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <float> level: -1;
    in property <bool> warn;
    in property <length> side;
    property <color> tint: root.warn ? Palette.red
        : root.icon == "timer" ? Palette.orange
        : root.icon == "bolt" || root.icon == "battery" ? Palette.green
        : root.icon == "calendar" ? Palette.accent
        : root.icon == "ai" ? Palette.purple
        : root.icon == "music" ? #ff375f
        : root.icon == "awake" ? Palette.yellow
        : root.icon == "download" ? Palette.teal
        : root.icon == "mic" ? Palette.orange
        : root.icon == "camera" ? Palette.green
        : root.icon == "moon" ? Palette.purple
        : Palette.fg;
    in property <image> image;
    in property <bool> has-image;
    in property <int> pulse;

    // Left: icon (a ring for progress), right: value.
    Rectangle {
        x: 0;
        width: root.side;
        if root.level >= 0 && root.icon == "timer": Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            stroke: root.tint;
            stroke-width: 2.5px;
            // Arc from 12 o'clock, clockwise by `level`.
            property <float> a: clamp(root.level, 0.001, 0.999) * 360;
            commands: "M 8 1.5 A 6.5 6.5 0 " + (self.a > 180 ? "1" : "0") + " 1 "
                + (8 + 6.5 * sin(self.a * 1deg)) + " " + (8 - 6.5 * cos(self.a * 1deg));
        }
        if root.has-image: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 5px;
            clip: true;
            Image { width: 100%; height: 100%; source: root.image; image-fit: cover; }
        }
        if !root.has-image && !(root.level >= 0 && root.icon == "timer"): Icon {
            width: 15px;
            height: 15px;
            name: root.icon;
            tint: root.tint;
        }
    }
    Rectangle {
        x: root.width - root.side;
        width: root.side;
        if root.level >= 0 && root.icon != "timer": Rectangle {
            width: parent.width - 22px;
            height: 5px;
            border-radius: 2.5px;
            background: Palette.surface-hover;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.level, 0, 1);
                border-radius: 2.5px;
                background: root.tint;
                animate width { duration: 120ms; }
            }
        }
        // Equalizer: bar heights change with `pulse` (once a second) and ease between steps,
        // so it moves without redrawing every frame.
        if root.icon == "music": HorizontalLayout {
            alignment: center;
            spacing: 2px;
            for i in 4: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 3px;
                height: (4 + Math.mod(root.pulse * 7 + i * 5, 9)) * 1px;
                border-radius: 1.5px;
                background: root.tint;
                animate height { duration: 900ms; easing: ease-in-out; }
            }
        }
        if root.icon != "music" && (root.level < 0 || root.icon == "timer"): Text {
            text: root.text;
            color: root.tint;
            font-size: 12px;
            font-weight: 600;
        }
    }
}

export component NotchWindow inherits Window {
    title: "notch-utils";
    no-frame: true;
    always-on-top: root.on-top;
    background: transparent;

    in property <bool> on-top: true;
    in property <NotchState> state: NotchState.collapsed;
    // Body size; animates. The window is resized from Rust (grow first, shrink after) and is
    // 2 x shoulder wider than the body.
    in property <length> shape-width: 160px;
    in property <length> shape-height: 24px;
    in property <length> shoulder: 10px;
    in property <color> shape-color: black;
    // Height of the camera housing (0 without a hardware notch) and its width.
    in property <length> top-inset: 0px;
    in property <length> camera-width: 0px;
    in property <string> peek-text;
    // Live activity beside the notch (only drawn while collapsed).
    in property <bool> activity-active;
    in property <string> activity-icon;
    in property <string> activity-text;
    in property <float> activity-level: -1;
    in property <bool> activity-warn;
    in property <image> activity-image;
    in property <bool> activity-has-image;
    in property <int> activity-pulse;
    in property <length> activity-side: 64px;
    in property <[ModuleTab]> modules;
    in property <[ModuleTab]> tabs-left;
    in property <[ModuleTab]> tabs-right;
    in property <bool> grid;
    in-out property <int> active-tab;

    callback clicked();
    callback tab-changed(int);

    property <bool> open: root.state == NotchState.expanded;
    property <length> radius: root.open ? 28px : min(root.shape-height / 2, 12px);
    // Height of the top band holding the tab icons.
    property <length> band: max(root.top-inset, 30px);

    function select(i: int) {
        root.active-tab = i;
        root.tab-changed(i);
    }

    // Body + concave shoulders into the menu bar, drawn 1:1 (viewbox = size).
    Path {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.shape-width + 2 * root.shoulder;
        height: root.shape-height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: root.shape-color;
        property <float> w: root.shape-width / 1px;
        property <float> h: root.shape-height / 1px;
        property <float> s: root.shoulder / 1px;
        property <float> r: min(root.radius, root.shape-height / 2) / 1px;
        commands: "M 0 0 L " + (self.w + 2 * self.s) + " 0"
            + " Q " + (self.w + self.s) + " 0 " + (self.w + self.s) + " " + self.s
            + " L " + (self.w + self.s) + " " + (self.h - self.r)
            + " Q " + (self.w + self.s) + " " + self.h + " " + (self.w + self.s - self.r) + " " + self.h
            + " L " + (self.s + self.r) + " " + self.h
            + " Q " + self.s + " " + self.h + " " + self.s + " " + (self.h - self.r)
            + " L " + self.s + " " + self.s
            + " Q " + self.s + " 0 0 0 Z";
    }

    body := Rectangle {
        x: (root.width - self.width) / 2;
        y: 0;
        width: root.shape-width;
        height: root.shape-height;
        clip: true;

        animate width, height { duration: 380ms; easing: cubic-bezier(0.3, 1.25, 0.45, 1); }

        // Behind the content: catches clicks that no module control handled.
        TouchArea {
            clicked => { root.clicked(); }
        }

        if root.state == NotchState.collapsed && root.activity-active: Activity {
            height: max(root.top-inset, root.shape-height);
            width: parent.width;
            icon: root.activity-icon;
            text: root.activity-text;
            level: root.activity-level;
            warn: root.activity-warn;
            side: root.activity-side;
            image: root.activity-image;
            has-image: root.activity-has-image;
            pulse: root.activity-pulse;
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 200ms; delay: 150ms; }
        }

        if root.state == NotchState.peek: Text {
            y: root.top-inset;
            height: parent.height - root.top-inset;
            width: parent.width;
            text: root.peek-text;
            color: Palette.fg;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.open: Rectangle {
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 220ms; delay: 120ms; }

            // Tab icons in the camera band, left and right of the notch.
            if root.modules.length > 1: HorizontalLayout {
                x: parent.width / 2 - root.camera-width / 2 - 12px - self.preferred-width;
                y: (root.band - 26px) / 2;
                height: 26px;
                spacing: 4px;
                for t in root.tabs-left: TabIcon {
                    tab: t;
                    active: t.index == root.active-tab;
                    select(i) => { root.select(i); }
                }
            }
            if root.modules.length > 1: HorizontalLayout {
                x: parent.width / 2 + root.camera-width / 2 + 12px;
                y: (root.band - 26px) / 2;
                height: 26px;
                spacing: 4px;
                for t in root.tabs-right: TabIcon {
                    tab: t;
                    active: t.index == root.active-tab;
                    select(i) => { root.select(i); }
                }
            }

            content := VerticalLayout {
                y: root.band + 4px;
                height: parent.height - self.y;
                padding: 16px;
                padding-top: 6px;
                spacing: 10px;

                if root.modules.length == 0: Text {
                    text: "No modules enabled. Open Settings from the menu bar icon.";
                    color: Palette.fg-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }

                if !root.grid && root.modules.length > 0: ModuleView {
                    id: root.modules[min(root.active-tab, root.modules.length - 1)].id;
                    vertical-stretch: 1;
                }

                if root.grid: HorizontalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    for m in root.modules: Card {
                        VerticalLayout {
                            padding: 10px;
                            Text { text: m.title; color: Palette.fg-dim; font-size: 11px; }
                            ModuleView { id: m.id; vertical-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "notch-utils";

    callback toggle();
    callback open-settings();
    callback quit();

    Menu {
        MenuItem { title: "Toggle notch"; activated => { root.toggle(); } }
        MenuItem { title: "Settings…"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "Quit notch-utils"; activated => { root.quit(); } }
    }
}
